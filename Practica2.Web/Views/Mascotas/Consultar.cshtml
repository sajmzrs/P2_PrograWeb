@model List<MascotaConsultaModel>
@{
    ViewData["Title"] = "Consulta de Mascotas";
}

<h2>Consulta de Mascotas</h2>
<hr />

@if (Model.Count == 0)
{
    <div class="alert alert-info">No hay mascotas registradas.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-primary">
            <tr>
                <th>Cédula del cliente</th>
                <th>Nombre del cliente</th>
                <th>Nombre de la mascota</th>
                <th>Especie</th>
                <th>Peso (kg)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CedulaCliente</td>
                    <td>@item.NombreCliente</td>
                    <td>@item.NombreMascota</td>
                    <td>@item.Especie</td>
                    <td>@item.Peso.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}
