@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mt-4">
    <h1 class="display-5">Bienvenido</h1>
    <p class="lead">Seleccione una de las opciones del menú para continuar.</p>

    <div class="row justify-content-center mt-4">
        <div class="col-md-3 mb-3">
            <a class="btn btn-outline-primary w-100 py-3" asp-controller="Clientes" asp-action="Registrar">Registro de Clientes</a>
        </div>
        <div class="col-md-3 mb-3">
            <a class="btn btn-outline-primary w-100 py-3" asp-controller="Mascotas" asp-action="Registrar">Registro de Mascotas</a>
        </div>
        <div class="col-md-3 mb-3">
            <a class="btn btn-outline-primary w-100 py-3" asp-controller="Mascotas" asp-action="Consultar">Consulta de Mascotas</a>
        </div>
    </div>
</div>
